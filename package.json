{
  "name": "@unofficialbox/box-open-elements",
  "version": "0.19.0",
  "description": "Box Open Elements: an open, framework-agnostic design system and web component library for Box-style experiences",
  "license": "MIT",
  "homepage": "https://unofficialbox.github.io/box-open-elements",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unofficialbox/box-open-elements.git"
  },
  "bugs": {
    "url": "https://github.com/unofficialbox/box-open-elements/issues"
  },
  "keywords": [
    "box",
    "box-ui-elements",
    "design-system",
    "web-components",
    "custom-elements",
    "ui-components",
    "framework-agnostic"
  ],
  "packageManager": "bun@1.3.11",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./*": {
      "types": "./dist/entries/*.d.ts",
      "import": "./dist/entries/*.js"
    },
    "./foundations/*": {
      "types": "./dist/foundations/*/index.d.ts",
      "import": "./dist/foundations/*/index.js"
    },
    "./components/*": {
      "types": "./dist/components/*.d.ts",
      "import": "./dist/components/*.js"
    },
    "./patterns/content-explorer": {
      "types": "./dist/patterns/content-explorer/index.d.ts",
      "import": "./dist/patterns/content-explorer/index.js"
    },
    "./patterns/content-explorer/selection": {
      "types": "./dist/patterns/content-explorer/selection/index.d.ts",
      "import": "./dist/patterns/content-explorer/selection/index.js"
    },
    "./patterns/content-explorer/collection": {
      "types": "./dist/patterns/content-explorer/collection/index.d.ts",
      "import": "./dist/patterns/content-explorer/collection/index.js"
    },
    "./patterns/content-explorer/navigation": {
      "types": "./dist/patterns/content-explorer/navigation/index.d.ts",
      "import": "./dist/patterns/content-explorer/navigation/index.js"
    },
    "./patterns/content-explorer/actions": {
      "types": "./dist/patterns/content-explorer/actions/index.d.ts",
      "import": "./dist/patterns/content-explorer/actions/index.js"
    },
    "./patterns/content-picker": {
      "types": "./dist/patterns/content-picker/index.d.ts",
      "import": "./dist/patterns/content-picker/index.js"
    },
    "./patterns/content-uploader": {
      "types": "./dist/patterns/content-uploader/index.d.ts",
      "import": "./dist/patterns/content-uploader/index.js"
    },
    "./patterns/content-sidebar": {
      "types": "./dist/patterns/content-sidebar/index.d.ts",
      "import": "./dist/patterns/content-sidebar/index.js"
    },
    "./patterns/form-wizard": {
      "types": "./dist/patterns/form-wizard/index.d.ts",
      "import": "./dist/patterns/form-wizard/index.js"
    },
    "./patterns/timeline": {
      "types": "./dist/patterns/timeline/index.d.ts",
      "import": "./dist/patterns/timeline/index.js"
    },
    "./patterns/diff": {
      "types": "./dist/patterns/diff/index.d.ts",
      "import": "./dist/patterns/diff/index.js"
    },
    "./patterns/work-queue": {
      "types": "./dist/patterns/work-queue/index.d.ts",
      "import": "./dist/patterns/work-queue/index.js"
    },
    "./patterns/versions": {
      "types": "./dist/patterns/versions/index.d.ts",
      "import": "./dist/patterns/versions/index.js"
    },
    "./patterns/lineage": {
      "types": "./dist/patterns/lineage/index.d.ts",
      "import": "./dist/patterns/lineage/index.js"
    },
    "./patterns/agent-chat": {
      "types": "./dist/patterns/agent-chat/index.d.ts",
      "import": "./dist/patterns/agent-chat/index.js"
    },
    "./patterns/audit": {
      "types": "./dist/patterns/audit/index.d.ts",
      "import": "./dist/patterns/audit/index.js"
    },
    "./patterns/notifications": {
      "types": "./dist/patterns/notifications/index.d.ts",
      "import": "./dist/patterns/notifications/index.js"
    },
    "./patterns/search": {
      "types": "./dist/patterns/search/index.d.ts",
      "import": "./dist/patterns/search/index.js"
    },
    "./patterns/item": {
      "types": "./dist/patterns/item/index.d.ts",
      "import": "./dist/patterns/item/index.js"
    },
    "./patterns/metadata": {
      "types": "./dist/patterns/metadata/index.d.ts",
      "import": "./dist/patterns/metadata/index.js"
    },
    "./patterns/share": {
      "types": "./dist/patterns/share/index.d.ts",
      "import": "./dist/patterns/share/index.js"
    },
    "./patterns/preview": {
      "types": "./dist/patterns/preview/index.d.ts",
      "import": "./dist/patterns/preview/index.js"
    },
    "./patterns/file-request": {
      "types": "./dist/patterns/file-request/index.d.ts",
      "import": "./dist/patterns/file-request/index.js"
    },
    "./patterns/task": {
      "types": "./dist/patterns/task/index.d.ts",
      "import": "./dist/patterns/task/index.js"
    },
    "./patterns/governance": {
      "types": "./dist/patterns/governance/index.d.ts",
      "import": "./dist/patterns/governance/index.js"
    },
    "./patterns/insights": {
      "types": "./dist/patterns/insights/index.d.ts",
      "import": "./dist/patterns/insights/index.js"
    },
    "./patterns/*": {
      "types": "./dist/patterns/*.d.ts",
      "import": "./dist/patterns/*.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "bun run build:core && bun run build:adapters",
    "build:core": "tsc -p tsconfig.json",
    "build:adapters": "bun run adapters:version && bun run --cwd packages/react build && bun run --cwd packages/angular build && bun run --cwd packages/vue build && bun run --cwd packages/svelte build",
    "build:watch": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "prepublishOnly": "bun run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p packages/box-server/tsconfig.json --noEmit && bun run adapters:typecheck && tsc -p storybook/tsconfig.json --noEmit",
    "adapters:typecheck": "bun run --cwd packages/react typecheck && bun run --cwd packages/angular typecheck && bun run --cwd packages/vue typecheck && bun run --cwd packages/svelte typecheck",
    "adapters:version": "bun tools/adapters/version-check.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "verify": "bun run typecheck && bun run test:coverage && bun run build && bun run frameworks:validate",
    "frameworks:react": "tsc --noEmit -p examples/frameworks/react/tsconfig.json && vite build --config examples/frameworks/react/vite.config.ts",
    "frameworks:react:ssr": "next build examples/frameworks/react-ssr",
    "frameworks:angular": "ngc -p examples/frameworks/angular/tsconfig.json && vite build --config examples/frameworks/angular/vite.config.ts",
    "frameworks:vue": "vue-tsc --noEmit -p examples/frameworks/vue/tsconfig.json && vite build --config examples/frameworks/vue/vite.config.ts",
    "frameworks:svelte": "svelte-check --tsconfig examples/frameworks/svelte/tsconfig.json && vite build --config examples/frameworks/svelte/vite.config.ts",
    "frameworks:svelte:ssr": "vite build --config examples/frameworks/svelte-ssr/vite.config.ts && node .framework-validation/svelte-ssr/entry.js",
    "frameworks:validate": "bun run frameworks:react && bun run frameworks:react:ssr && bun run frameworks:angular && bun run frameworks:vue && bun run frameworks:svelte && bun run frameworks:svelte:ssr",
    "style-bridge": "bun tools/style-bridge/cli.ts",
    "style-bridge:bue-explorer": "bun tools/style-bridge/cli.ts --config tools/style-bridge/configs/box-ui-elements/content-explorer.config.json --input tools/style-bridge/libraries/box-ui-elements/content-explorer/index.scss --out tools/style-bridge/out/box-ui-elements/content-explorer.css --report tools/style-bridge/out/box-ui-elements/content-explorer.report.json",
    "preview:capture": "bun run build && bun tools/preview/capture.ts",
    "docs": "bun run build && bun docs-site/server.ts",
    "docs:typecheck": "tsc -p docs-site/tsconfig.json",
    "docs:build": "bun run build && bun docs-site/build.ts",
    "site:build": "bun run build && bun docs-site/build.ts",
    "docs:shots": "bun run build && bun tools/preview/docs-site-shots.ts",
    "test:regression": "bun run build && bun tools/preview/regression.ts",
    "test:regression:pixel": "bash tools/preview/container-run.sh 'bun run test:regression -- --pixel'",
    "baselines:regen": "bash tools/preview/container-run.sh 'bun run build && bun tools/preview/capture.ts && bun tools/preview/docs-site-shots.ts'",
    "maps:generate": "bun tools/generate-element-maps.ts",
    "icons:generate": "bun tools/iconography/generate-box-iconography.ts",
    "bue-conformance": "bun tools/bue-conformance/audit.ts",
    "bue-conformance:color": "bun tools/bue-conformance/color-audit.ts",
    "bue-conformance:webapp": "bun tools/bue-conformance/webapp-audit.ts",
    "storybook:extract": "bun storybook/extract.ts",
    "storybook:dev": "bun run build && bun storybook/server.ts",
    "storybook:build": "bun run build && bun storybook/build.ts"
  },
  "devDependencies": {
    "@angular/compiler": "20.3.27",
    "@angular/compiler-cli": "20.3.27",
    "@angular/core": "20.3.27",
    "@angular/platform-browser": "20.3.27",
    "@sveltejs/package": "2.5.8",
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@types/node": "24.10.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@unofficialbox/box-open-elements-react": "workspace:*",
    "@unofficialbox/box-open-elements-angular": "workspace:*",
    "@unofficialbox/box-open-elements-svelte": "workspace:*",
    "@unofficialbox/box-open-elements-vue": "workspace:*",
    "@vitejs/plugin-vue": "6.0.8",
    "@vue/server-renderer": "3.5.40",
    "@vitest/coverage-v8": "^4.1.2",
    "bun-types": "^1.3.14",
    "jsdom": "^29.0.1",
    "next": "16.2.12",
    "pixelmatch": "^7.2.0",
    "playwright-core": "^1.61.1",
    "pngjs": "^7.0.0",
    "react": "19",
    "react-dom": "19",
    "rxjs": "7.8.2",
    "svelte": "5.56.8",
    "svelte-check": "4.3.4",
    "typescript": "^5.8.2",
    "vite": "8.2.0",
    "vitest": "^4.1.2",
    "vue": "3.5.40",
    "vue-tsc": "3.1.5",
    "zone.js": "0.15.1"
  }
}
