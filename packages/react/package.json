{
  "name": "@unofficialbox/box-open-elements-react",
  "version": "0.18.0",
  "description": "Optional React wrappers for box-open-elements Web Components. Thin adapters — core stays framework-agnostic.",
  "license": "MIT",
  "homepage": "https://unofficialbox.github.io/box-open-elements",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unofficialbox/box-open-elements.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/unofficialbox/box-open-elements/issues"
  },
  "keywords": [
    "react",
    "web-components",
    "design-system",
    "box"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "peerDependencies": {
    "@unofficialbox/box-open-elements": "^0.18.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
