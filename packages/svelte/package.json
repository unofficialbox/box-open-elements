{
  "name": "@unofficialbox/box-open-elements-svelte",
  "version": "0.11.0",
  "description": "Typed Svelte adapters for box-open-elements Web Components.",
  "license": "MIT",
  "homepage": "https://unofficialbox.github.io/box-open-elements",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unofficialbox/box-open-elements.git",
    "directory": "packages/svelte"
  },
  "bugs": {
    "url": "https://github.com/unofficialbox/box-open-elements/issues"
  },
  "keywords": ["svelte", "web-components", "design-system", "box"],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "svelte": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js",
      "import": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "peerDependencies": {
    "@unofficialbox/box-open-elements": "^0.11.0",
    "svelte": ">=5.0.0 <6.0.0"
  },
  "scripts": {
    "build": "svelte-package --input src --output dist",
    "prepublishOnly": "bun run build",
    "typecheck": "svelte-check --tsconfig tsconfig.json"
  }
}
