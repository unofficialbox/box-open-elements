{
  "name": "@unofficialbox/box-open-elements-preact",
  "version": "0.45.0",
  "description": "Optional native preact adapters for box-open-elements Web Components.",
  "license": "MIT",
  "homepage": "https://unofficialbox.github.io/box-open-elements",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/unofficialbox/box-open-elements.git",
    "directory": "packages/preact"
  },
  "bugs": {
    "url": "https://github.com/unofficialbox/box-open-elements/issues"
  },
  "keywords": [
    "preact",
    "web-components",
    "design-system",
    "box"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js"
    },
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "peerDependencies": {
    "@unofficialbox/box-open-elements": "^0.45.0",
    "preact": "^11.0.1"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "bun run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
